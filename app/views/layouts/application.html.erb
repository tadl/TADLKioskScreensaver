<!DOCTYPE html>
<html lang="en">
  <head>
    <title>KioskScreensaver</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="Cache-Control" content="no-store">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "tadl-icon.png", type: "image/png" %>
    <%= favicon_link_tag "tadl-icon-dark.png", type: "image/png", media: "(prefers-color-scheme: dark)" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-app">
    <main class="admin-login">
      <%= yield %>
    </main>
  </body>
</html>
