<section class="admin-login-card">
  <div class="admin-login-brand"><%= image_tag "tadl-icon-dark.png", alt: "", width: 80, height: 80 %></div>
  <p class="admin-eyebrow">Traverse Area District Library</p>
  <h1>Kiosk Screensaver</h1>
  <p class="my-5 text-sm leading-relaxed text-slate-500">Sign in with your staff Google account to manage slides, screens, and the spaces they serve.</p>
  <% flash.each do |_, message| %><div class="admin-flash admin-flash-alert" role="alert"><%= message %></div><% end %>
  <form action="/auth/google_oauth2" method="post" data-turbo="false">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <button type="submit" class="admin-button admin-button-primary w-full">Sign in with Google →</button>
  </form>
</section>
