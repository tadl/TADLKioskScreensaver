<% display_name = current_user.name.presence || current_user.email %>
<details class="admin-account" data-controller="account-menu" data-action="click@window->account-menu#clickOutside keydown.esc@window->account-menu#closeWithEscape focusout->account-menu#focusOut">
  <summary class="admin-account-toggle" aria-label="Account menu for <%= display_name %>" aria-controls="admin-account-panel" data-account-menu-target="trigger">
    <span class="admin-avatar" aria-hidden="true">
      <span><%= display_name.first.upcase %></span>
      <% if (avatar_url = admin_avatar_url(current_user)) %>
        <%= image_tag avatar_url, alt: "", width: 36, height: 36, class: "admin-avatar-image", referrerpolicy: "no-referrer", data: { account_menu_target: "avatar", action: "error->account-menu#avatarFailed" } %>
      <% end %>
    </span>
    <span class="hidden sm:inline"><%= display_name %></span>
    <svg class="admin-account-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </summary>
  <div id="admin-account-panel" class="admin-account-panel">
    <div class="admin-account-identity">
      <p class="admin-muted">Signed in as</p>
      <p class="font-semibold mt-1"><%= display_name %></p>
      <p class="admin-muted break-all mt-1"><%= current_user.email %></p>
    </div>
    <%= link_to "Help", admin_help_path, class: "admin-account-link" %>
    <%= button_to "Sign out", logout_path, method: :delete, class: "admin-signout" %>
  </div>
</details>
