<div class="admin-overview" data-controller="overview"
     data-overview-url-value="<%= admin_root_path(format: :json) %>"
     data-overview-tab-value="<%= @active_tab %>"
     data-action="visibilitychange@document->overview#resume online@window->overview#refresh">
  <h1 class="sr-only">Overview</h1>
  <div class="admin-metrics">
    <article class="admin-metric">
      <span>Accessible kiosks</span>
      <strong><span data-overview-target="metric" data-metric="kiosks"><%= @status_snapshot[:metrics][:kiosks] %></span></strong>
      <small>Your content destinations</small>
    </article>
    <article class="admin-metric">
      <span>In use</span>
      <strong><span data-overview-target="metric" data-metric="in_use"><%= @status_snapshot[:metrics][:in_use] %></span><i class="admin-dot bg-emerald-500" aria-hidden="true"></i></strong>
      <small>Hosts browsing the catalog</small>
    </article>
    <article class="admin-metric">
      <span>Screensaver</span>
      <strong><span data-overview-target="metric" data-metric="screensaver"><%= @status_snapshot[:metrics][:screensaver] %></span><i class="admin-dot bg-amber-400" aria-hidden="true"></i></strong>
      <small>Hosts showing their slides</small>
    </article>
    <article class="admin-metric">
      <span>Usage sessions</span>
      <strong><span data-overview-target="metric" data-metric="usage_sessions"><%= @status_snapshot[:metrics][:usage_sessions] %></span></strong>
      <small>For the selected reporting range</small>
    </article>
  </div>

  <div class="admin-flash admin-flash-warning admin-overview-warning" data-overview-target="fallback" <%= "hidden" unless @status_snapshot[:fallback_missing] %>>
    <strong>No active fallback slides.</strong> Kiosks without active assigned content will show the empty screen.
    <% if current_user.admin? %>
      <%= link_to "Manage fallback slides →", admin_slides_path(fallback: "true"), class: "font-semibold underline" %>
    <% else %> Ask an administrator to add a fallback.<% end %>
  </div>

  <div class="admin-overview-toolbar">
    <nav class="admin-overview-tabs" role="tablist" aria-label="Overview views">
      <% { "status" => "Live status", "stats" => "Stats" }.each do |tab, label| %>
        <%= link_to label, admin_root_path(request.query_parameters.merge("tab" => tab)),
          id: "overview-#{tab}-tab", role: "tab", class: "admin-overview-tab",
          aria: { selected: @active_tab == tab, controls: "overview-#{tab}-panel" },
          data: { overview_target: "tab", tab: tab, action: "click->overview#select keydown->overview#navigate" } %>
      <% end %>
    </nav>
    <span class="admin-overview-refresh" data-overview-target="refreshStatus" role="status">
      Updates every 30s
    </span>
  </div>

  <section id="overview-status-panel" class="admin-panel admin-overview-panel" role="tabpanel"
           aria-labelledby="overview-status-tab" tabindex="0" data-overview-target="panel" data-tab="status"
           <%= "hidden" unless @active_tab == "status" %>>
    <div class="admin-status-grid" data-overview-target="grid" <%= "hidden" if @status_snapshot[:kiosks].empty? %>>
      <%= render partial: "status_card", collection: @status_snapshot[:kiosks], as: :kiosk %>
    </div>
    <div class="admin-empty" data-overview-target="empty" <%= "hidden" unless @status_snapshot[:kiosks].empty? %>>
      <h2>Waiting for your kiosks</h2>
      <p>Status appears when a host enters the screensaver or opens the catalog.</p>
    </div>
  </section>

  <%= render "stats" %>

  <template data-overview-target="kioskTemplate"><%= render "status_card", kiosk: nil %></template>
  <template data-overview-target="hostTemplate"><%= render "status_host", host: nil %></template>
</div>
